{
  "name": "mekamemo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "backend:dev": "npm run start:dev --workspace=apps/backend",
    "backend:test": "npm run test --workspace=apps/backend",
    "backend:test:e2e": "npm run test:e2e --workspace=apps/backend",
    "mobile:start": "npm run start --workspace=apps/mobile",
    "mobile:web": "npm run web --workspace=apps/mobile",
    "mobile:test": "npm run test --workspace=apps/mobile"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "esbuild@0.21.5": true,
    "unrs-resolver@1.12.2": true,
    "bcrypt@6.0.0": true,
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}

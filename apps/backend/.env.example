DATABASE_URL="postgresql://mekamemo:mekamemo@127.0.0.1:54322/mekamemo?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
NHTSA_VPIC_BASE_URL="https://vpic.nhtsa.dot.gov/api"
# Comma-separated list of allowed origins (e.g. your Vercel/Netlify URL). Empty = allow any origin (dev default).
CORS_ORIGIN=""
# Cloudinary free tier — set this in production so uploaded photos/invoices survive
# a restart (Render's free filesystem is wiped on every redeploy/sleep). Format:
# cloudinary://<api_key>:<api_secret>@<cloud_name> — from your Cloudinary dashboard.
# Leave empty to keep saving to local disk (fine for local dev).
CLOUDINARY_URL=""
# "true" = free postal-code geocoding (OpenStreetMap, no key) and the demo garages hidden because
# the database holds real ones (loaded by `npm run import:garages`). Empty = a fixed Montreal
# point and the demo garages (dev and tests, no network needed).
OSM_ENABLED=""
# "true" also looks up garages live on OpenStreetMap at search time (adds the few services and
# opening hours OSM knows; costs a few seconds on the first search of an area). Off by default.
OSM_GARAGE_DISCOVERY=""
# Identifies this app to the OpenStreetMap servers, as their usage policy asks. Optional.
OSM_USER_AGENT=""
ANTHROPIC_API_KEY=""
GOOGLE_PLACES_API_KEY=""
# Outgoing e-mail (password-reset codes, garage quote requests). With neither key set, messages are
# only written to the server log. Brevo's free plan (300 e-mails a day) works with just a verified
# sender address; Resend needs a domain you own. SMTP can't be used on Render's free plan (blocked).
BREVO_API_KEY=""
# Shown as the sender, e.g. "MekaMemo <you@example.com>". Must be an address verified at your provider.
MAIL_FROM=""
EMAIL_PROVIDER_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
REVENUECAT_API_KEY=""
REVENUECAT_WEBHOOK_SECRET=""
EXPO_PUSH_ACCESS_TOKEN=""
EMAIL_INBOUND_WEBHOOK_SECRET=""

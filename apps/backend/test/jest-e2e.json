{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": ["<rootDir>/test-env.js"],
  "globalSetup": "<rootDir>/global-setup.js",
  "globalTeardown": "<rootDir>/global-teardown.js",
  "testTimeout": 30000,
  "maxWorkers": 1
}
